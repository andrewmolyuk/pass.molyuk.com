{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pass-molyuk-com",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pass-relay-db",
      "database_id": "e1779972-059a-46dd-a760-587d9a71ee3a"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "routes": [
    {
      "pattern": "pass.molyuk.com",
      "custom_domain": true
    }
  ]
}
